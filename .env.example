# Postgres (docker compose exposes it on localhost:5432)
DATABASE_URL=postgres://app:app@localhost:5432/app
# Used by Vitest; the test setup creates it if missing
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test
# HMAC key for the mock auth session cookie (any long random string locally)
SESSION_SECRET=change-me-to-a-long-random-string
# Adapter selection
AUTH_ADAPTER=mock
PAYMENTS_ADAPTER=mock
# Base URL the mock payments adapter calls (the in-repo /api/mock-payments route)
MOCK_PAYMENTS_BASE_URL=http://localhost:3000/api/mock-payments
PAYMENTS_TIMEOUT_MS=5000
